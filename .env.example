# 复制为 .env。密钥只在服务器读取，不会传给网页。
HOST=127.0.0.1
PORT=3210
BAILIAN_API_KEY=
BAILIAN_TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_TEXT_MODEL=qwen3.8-max
# 接入前在北京地域业务空间确认最新可用型号，失败时不会切换供应商。
QWEN_IMAGE_MODEL=qwen-image-2.1-pro
IMAGE_CONCURRENCY=1
# 留空使用保守间隔：3.0 Pro 13 秒、其余 4 秒；共享 Key 限流时可提高。
IMAGE_MIN_INTERVAL_MS=
MAX_IMAGE_JOBS=12
SESSION_SECRET=
# 本机预览可留空；多人部署前设置密码，或在反向代理接入公司登录。
APP_ACCESS_PASSWORD=
# Linux 容器使用 /usr/bin/chromium；本机留空自动发现。
CHROMIUM_EXECUTABLE=
